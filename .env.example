# --- PayPal (sandbox) --- https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: webhook id from the same app's Webhooks section (needs a public URL, e.g. your Render URL)
PAYPAL_WEBHOOK_ID=
# The sandbox *personal* account email you will pay invoices with (Sandbox > Accounts)
SANDBOX_BUYER_EMAIL=

# --- AI: set ONE of these ---
# Free: Google Gemini key from https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Paid alternative: Claude key from https://console.anthropic.com (needs API credit)
ANTHROPIC_API_KEY=

PORT=3000
